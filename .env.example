# Aurora-ICT 환경변수 박은 거 (실 박힘 = .env 박힘 박힘)
# 박힌 거 박힘 .env 박힙 박힘 박힘 박힘 박힘 박힘 박힘 박힘 .gitignore 박힘 박힙 박힘.

# ============================================================
# 봇 모드
# ============================================================
# demo (기본) — Bybit Demo Trading (실거래 X)
# live — Bybit 실매매 (조심)
AURORA_ICT_RUN_MODE=demo

# 봇 ON/OFF — false 박힘 박힘 박힘 박힘 start API 박힘 박힘 X
AURORA_ICT_ENABLED=false

# ============================================================
# Bybit Demo Trading 키 (bybit.com → Demo 박힘 박힘 박힘 박힘)
# ============================================================
AURORA_ICT_DEMO_API_KEY=
AURORA_ICT_DEMO_API_SECRET=

# ============================================================
# Bybit 실매매 키 (실거래 박힘 박힘 — 박힙 박힘 박힘 박힘 박힘 박힘)
# ============================================================
AURORA_ICT_LIVE_API_KEY=
AURORA_ICT_LIVE_API_SECRET=

# ============================================================
# 매매 파라미터
# ============================================================
AURORA_ICT_SYMBOL=BTC/USDT:USDT
AURORA_ICT_TIMEFRAME=1m
AURORA_ICT_RISK_PER_TRADE_PCT=0.5
AURORA_ICT_LEVERAGE=5
AURORA_ICT_MIN_RR=2.0
AURORA_ICT_FVG_MIN_SIZE_PCT=0.0005
AURORA_ICT_STEP_INTERVAL_SEC=60
AURORA_ICT_OHLCV_LIMIT=200

# ============================================================
# 서버 박힘 박힘
# ============================================================
AURORA_ICT_HOST=127.0.0.1
AURORA_ICT_PORT=8765
AURORA_ICT_LOG_LEVEL=INFO
