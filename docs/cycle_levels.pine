// Cycle(순환매) 지지/저항 — TradingView 검증용
// 2026-08-18. Aurora-ICT 의 src/aurora_ict/indicators/cycle_levels.py 와 같은 규칙.
//
// 파이썬 쪽과 맞춘 것
//   · 구름대  : 일목 9/26/52. 선행스팬 A/B 를 displacement-1(=25)만큼 앞으로 민 값,
//               즉 "지금 화면에 그려져 있는 구름"을 판정에 쓴다.
//               상위 TF 는 request.security + lookahead_off + [1] 로 **마감된 봉**만
//               본다. 이걸 빼면 진행 중인 상위 봉 값이 새어 미래참조가 된다.
//   · 매물대  : 최근 300봉을 40구간으로 쪼갠 가격대별 거래량 상위 5개 중심가.
//               (시간대별이 아니라 가격대별 — 나뇨띠 매물대 자료의 강조점)
//   · 2468    : 1K 단위 안의 +200/+400(상방) · +600/+800(하방). 방향 필터 적용.
//   · 터치판정: 지지 = 위에서 내려와 레벨에 닿고 그 위에서 마감
//               저항 = 아래서 올라가 레벨에 닿고 그 아래로 마감
//   · 쿨다운  : 같은 가격대(±0.4%) 재터치는 20봉 동안 다시 안 찍는다.
//               (없으면 한 자리를 스칠 때마다 봉마다 찍혀 차트가 뭉갠다)
//   · 라벨    : 겹친 자리는 **상위 TF 구름**을 우선 표기(상위 프레임 우선 원칙).
//               ◆ 개수 = 그 자리에 겹친 출처 **종류** 수(구름/매물/2468, 최대 3).
//
// 보는 법: 지지 = 봉 아래 초록 ◆ / 저항 = 봉 위 빨강 ◆.
//          ◆ 아래(지지) 또는 위(저항)에 출처 라벨 — 1h · 매물 · 2468.

//@version=5
indicator("Cycle 지지/저항 (Aurora)", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ── 입력 ─────────────────────────────────────────────────────────────────
grpL = "레벨 소스"
useCloud = input.bool(true, "구름대(일목 선행스팬 A/B)", group = grpL)
useVP    = input.bool(true, "매물대(가격대별 거래량)", group = grpL)
use2468  = input.bool(true, "2468 (1K 안 200/400/600/800)", group = grpL)

grpT = "상위 TF 구름"
tf1 = input.timeframe("15",  "TF 1", group = grpT)
tf2 = input.timeframe("60",  "TF 2", group = grpT)
tf3 = input.timeframe("120", "TF 3", group = grpT)
tf4 = input.timeframe("240", "TF 4", group = grpT)

grpB = "추세 표시"
showTrend = input.bool(true, "우상단에 현재 추세 표시", group = grpB)
trendTf   = input.timeframe("5", "추세 판단 TF", group = grpB)

grpD = "판정"
tolPct   = input.float(0.2, "터치 허용폭 %", minval = 0.01, step = 0.01, group = grpD)
cooldown = input.int(20, "같은 자리 재표시 대기(봉)", minval = 0, group = grpD)
vpLook   = input.int(300, "매물대 관찰 봉수", minval = 50, group = grpD)
vpBins   = input.int(40, "매물대 구간 수", minval = 10, group = grpD)
vpTop    = input.int(5, "매물대 상위 N", minval = 1, group = grpD)
thinRatio = input.float(0.35, "얇은 구름 제외 (자기 두께 중앙값 대비)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpD)
showCloud = input.bool(true, "구름 선 그리기", group = grpD)
showHtf   = input.bool(false, "상위 TF 구름도 그리기(검증용)", group = grpD)
showLevel = input.bool(true, "터치한 레벨을 선으로 표시(검증용)", group = grpD)

tol = tolPct / 100.0

// ── 일목 구름 (파이썬 cloud_spans 와 동일) ───────────────────────────────
f_mid(len) =>
    (ta.highest(high, len) + ta.lowest(low, len)) / 2.0

spanA_raw = (f_mid(9) + f_mid(26)) / 2.0
spanB_raw = f_mid(52)
// 파이썬의 shift(DISP-1). 25봉 전 계산값 = 지금 자리에 그려져 있는 구름.
spanA = spanA_raw[25]
spanB = spanB_raw[25]

// 얇은 구름은 지지/저항으로 안 친다(파트너: "저런 데는 뚫리기 쉽다").
// 임계는 **그 TF 자기 두께 대비 비율**. 고정 % 는 못 쓴다 — 실측 두께 중앙값이
// 3m 0.13% / 1h 0.75% / 4h 1.63% / 1D 6.10% 로 자릿수가 달라서, 0.1% 같은 값이면
// 3m 은 절반이 잘리고 1D 는 하나도 안 잘린다.
thickPct = math.abs(spanA - spanB) / close
thickMed = ta.median(thickPct, 200)
notThin = na(thickMed) or thinRatio <= 0.0 or thickPct >= thickMed * thinRatio

// 상위 TF — 함수 안에서 부르면 안 되므로 최상위에서 호출한다.
// [1] 을 붙이지 않는다: 선행스팬은 이미 25봉 전 데이터로 만들어져 진행 중인 봉의
// 영향을 안 받는다(미래참조 없음). 그런데도 [1] 을 붙였더니 상위 TF 한 봉만큼
// (4h 면 4시간) 레벨이 통째로 밀려서, 화면 구름과 안 맞는 자리에 마커가 찍혔다.
a1 = request.security(syminfo.tickerid, tf1, spanA, lookahead = barmerge.lookahead_off)
b1 = request.security(syminfo.tickerid, tf1, spanB, lookahead = barmerge.lookahead_off)
a2 = request.security(syminfo.tickerid, tf2, spanA, lookahead = barmerge.lookahead_off)
b2 = request.security(syminfo.tickerid, tf2, spanB, lookahead = barmerge.lookahead_off)
a3 = request.security(syminfo.tickerid, tf3, spanA, lookahead = barmerge.lookahead_off)
b3 = request.security(syminfo.tickerid, tf3, spanB, lookahead = barmerge.lookahead_off)
a4 = request.security(syminfo.tickerid, tf4, spanA, lookahead = barmerge.lookahead_off)
b4 = request.security(syminfo.tickerid, tf4, spanB, lookahead = barmerge.lookahead_off)
// 두께 판정은 그 TF 안에서 계산한 걸 가져온다(하위 차트에서 재면 계단이라 왜곡).
n1 = request.security(syminfo.tickerid, tf1, notThin, lookahead = barmerge.lookahead_off)
n2 = request.security(syminfo.tickerid, tf2, notThin, lookahead = barmerge.lookahead_off)
n3 = request.security(syminfo.tickerid, tf3, notThin, lookahead = barmerge.lookahead_off)
n4 = request.security(syminfo.tickerid, tf4, notThin, lookahead = barmerge.lookahead_off)

// TF 우선순위(분) — 겹치면 상위 TF 라벨을 쓴다.
m0 = math.round(timeframe.in_seconds(timeframe.period) / 60)
m1 = math.round(timeframe.in_seconds(tf1) / 60)
m2 = math.round(timeframe.in_seconds(tf2) / 60)
m3 = math.round(timeframe.in_seconds(tf3) / 60)
m4 = math.round(timeframe.in_seconds(tf4) / 60)

// ── 매물대 (파이썬 volume_profile_levels 와 동일) ────────────────────────
// 가격대별 거래량 상위 N 구간의 중심가. 봉마다 전 구간을 다시 도는 건 비싸서
// 파이썬과 같이 20봉마다만 갱신한다(300봉 창이라 그 사이 값이 거의 안 변한다).
var float[] vpLevels = array.new_float()

f_rebuildVP() =>
    out = array.new_float()
    hi = ta.highest(high, vpLook)
    lo = ta.lowest(low, vpLook)
    if not na(hi) and not na(lo) and hi > lo
        step = (hi - lo) / vpBins
        vols = array.new_float(vpBins, 0.0)
        for i = 0 to vpLook - 1
            mid = (high[i] + low[i]) / 2.0
            bi = math.min(vpBins - 1, math.max(0, int((mid - lo) / step)))
            array.set(vols, bi, array.get(vols, bi) + nz(volume[i]))
        for n = 1 to vpTop
            mx = array.max(vols)
            bi = array.indexof(vols, mx)
            if bi >= 0 and mx > 0
                array.push(out, lo + step * (bi + 0.5))
                array.set(vols, bi, -1.0)
    out

if useVP and bar_index % 20 == 0 and bar_index >= vpLook
    vpLevels := f_rebuildVP()

// ── 후보 레벨 담기 ───────────────────────────────────────────────────────
// 세 배열을 나란히 쓴다: 가격 / 출처(0=구름 1=매물 2=2468) / TF 분
f_push(arrP, arrS, arrT, v, s, t) =>
    if not na(v)
        array.push(arrP, v)
        array.push(arrS, s)
        array.push(arrT, t)

// 2468 — PDF 원문: 1K 안의 200/400(상방) · 600/800(하방)
f_push2468(arrP, arrS, arrT, price, isUp) =>
    k = math.floor(price / 1000)
    o1 = isUp ? 200 : 600
    o2 = isUp ? 400 : 800
    for d = -2 to 2
        b = (k + d) * 1000
        f_push(arrP, arrS, arrT, b + o1, 2, 0)
        f_push(arrP, arrS, arrT, b + o2, 2, 0)

// 터치 판정 (파이썬 touched 와 동일)
f_touch(level, isSup) =>
    band = level * tol
    isSup ? (close[1] > level and low <= level + band and close >= level - band) : (close[1] < level and high >= level - band and close <= level + band)

// 출처 라벨
f_label(srcCode, tfMin) =>
    srcCode == 1 ? "매물" : srcCode == 2 ? "2468" : tfMin >= 10080 ? "1W" : tfMin >= 1440 ? "1D" : tfMin >= 60 ? str.tostring(math.round(tfMin / 60)) + "h" : str.tostring(tfMin) + "m"

// ── 본 판정 ──────────────────────────────────────────────────────────────
var float lastPx  = na
var int   lastBar = -9999

// 지지를 먼저 보고, 없으면 저항. 파이썬도 한 봉에 하나만 찍는다.
for pass = 0 to 1
    isSup = pass == 0
    cPx = array.new_float()
    cSrc = array.new_int()
    cTf = array.new_int()

    if useCloud
        if notThin
            f_push(cPx, cSrc, cTf, spanA, 0, m0)
            f_push(cPx, cSrc, cTf, spanB, 0, m0)
        if n1
            f_push(cPx, cSrc, cTf, a1, 0, m1)
            f_push(cPx, cSrc, cTf, b1, 0, m1)
        if n2
            f_push(cPx, cSrc, cTf, a2, 0, m2)
            f_push(cPx, cSrc, cTf, b2, 0, m2)
        if n3
            f_push(cPx, cSrc, cTf, a3, 0, m3)
            f_push(cPx, cSrc, cTf, b3, 0, m3)
        if n4
            f_push(cPx, cSrc, cTf, a4, 0, m4)
            f_push(cPx, cSrc, cTf, b4, 0, m4)
    if useVP and array.size(vpLevels) > 0
        for i = 0 to array.size(vpLevels) - 1
            f_push(cPx, cSrc, cTf, array.get(vpLevels, i), 1, 0)
    if use2468
        f_push2468(cPx, cSrc, cTf, close, isSup)

    // 닿은 것 중 상위 TF 우선, 동률이면 현재가에 가까운 것
    bestPx = float(na)
    bestSrc = 0
    bestTf = -1
    if array.size(cPx) > 0
        for i = 0 to array.size(cPx) - 1
            v = array.get(cPx, i)
            if f_touch(v, isSup)
                t = array.get(cTf, i)
                better = na(bestPx) or t > bestTf or (t == bestTf and math.abs(v - close) < math.abs(bestPx - close))
                if better
                    bestPx := v
                    bestSrc := array.get(cSrc, i)
                    bestTf := t

    if not na(bestPx)
        // 겹친 출처 **종류** 수 (±0.4%) — 개수로 세면 매물대가 한 자리에 여럿
        // 몰려 늘 2 이상이 나와 변별력이 없다.
        hasCloud = false
        hasVP = false
        has24 = false
        for i = 0 to array.size(cPx) - 1
            if math.abs(array.get(cPx, i) - bestPx) / bestPx <= 0.004
                s = array.get(cSrc, i)
                hasCloud := hasCloud or s == 0
                hasVP := hasVP or s == 1
                has24 := has24 or s == 2
        cnt = (hasCloud ? 1 : 0) + (hasVP ? 1 : 0) + (has24 ? 1 : 0)

        cooled = na(lastPx) or (bar_index - lastBar) > cooldown or math.abs(bestPx - lastPx) / bestPx > 0.004
        if cooled
            lastPx := bestPx
            lastBar := bar_index
            dia = str.repeat("◆", math.max(1, math.min(3, cnt)))
            // 지지는 ◆ 아래에, 저항은 ◆ 위에 라벨이 오도록 줄 순서를 뒤집는다.
            txt = isSup ? dia + "\n" + f_label(bestSrc, bestTf) : f_label(bestSrc, bestTf) + "\n" + dia
            if showLevel
                // 판정에 쓴 레벨 가격을 그 자리에 짧게 긋는다. 상위 TF 구름은
                // 화면에 없어서 "아무것도 없는 자리"처럼 보였는데, 이 선이 있으면
                // 마커가 진짜 레벨을 잡은 건지 바로 대조된다.
                line.new(bar_index - 2, bestPx, bar_index + 2, bestPx, color = isSup ? color.new(#22c55e, 30) : color.new(#ef4444, 30), width = 1)
            label.new(bar_index, isSup ? low : high, txt, style = isSup ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = isSup ? color.new(#22c55e, 0) : color.new(#ef4444, 0), size = size.small)
            break

// ── 구름 선 ──────────────────────────────────────────────────────────────
// 정석 이치모쿠와 같이 **현재 계산값을 25봉 앞으로** 그린다. 전에는 25봉 전
// 계산값을 현재 자리에 그려(= 같은 그림) 미래 26봉 구간이 통째로 비어 있었다.
// 판정에는 여전히 "지금 자리에 그려져 있는 값"(spanA/spanB)을 쓴다.
pA = plot(showCloud and useCloud ? spanA_raw : na, "선행스팬 A", offset = 25, color = color.new(#22d3ee, 45))
pB = plot(showCloud and useCloud ? spanB_raw : na, "선행스팬 B", offset = 25, color = color.new(#f59e0b, 45))
// 얇은 구간(지지/저항으로 안 치는 구간)은 더 흐리게 칠해 눈으로 구분되게 한다.
fill(pA, pB, color = not notThin ? color.new(color.gray, 94) : spanA_raw >= spanB_raw ? color.new(#22d3ee, 88) : color.new(#f59e0b, 88))

// 상위 TF 구름 — 기본은 끔. 켜면 "왜 여기가 지지/저항인지"가 눈으로 보인다.
plot(showHtf and useCloud ? a1 : na, "TF1 A", color = color.new(#22d3ee, 70), style = plot.style_stepline)
plot(showHtf and useCloud ? b1 : na, "TF1 B", color = color.new(#f59e0b, 70), style = plot.style_stepline)
plot(showHtf and useCloud ? a2 : na, "TF2 A", color = color.new(#22d3ee, 60), style = plot.style_stepline)
plot(showHtf and useCloud ? b2 : na, "TF2 B", color = color.new(#f59e0b, 60), style = plot.style_stepline)
plot(showHtf and useCloud ? a3 : na, "TF3 A", color = color.new(#22d3ee, 50), style = plot.style_stepline)
plot(showHtf and useCloud ? b3 : na, "TF3 B", color = color.new(#f59e0b, 50), style = plot.style_stepline)
plot(showHtf and useCloud ? a4 : na, "TF4 A", color = color.new(#22d3ee, 40), style = plot.style_stepline)
plot(showHtf and useCloud ? b4 : na, "TF4 B", color = color.new(#f59e0b, 40), style = plot.style_stepline)


// ── 현재 추세 표시 ────────────────────────────────────────────────────────
// 백테와 같은 규칙: **추세 TF 의 종가가 그 TF 구름 위/아래/안** 으로 본다.
//   위  → 롱 · 아래 → 숏 · 안 → 중립(양쪽 허용)
// close 기반이라 그 봉이 닫혀야 확정된다 → [1] 로 한 봉 미룬다(미래참조 차단).
//
// ⚠ 이건 **예측이 아니다.** 실측 적중률이 1시간 뒤 47.2% / 4시간 뒤 47.1% 로
//    기저(50.4% / 50.7%)를 밑돈다. 그런데도 쓰는 이유는 손절 1% · 익절 3% 구조에서
//    기대값(R)을 올려주기 때문 — 방향을 맞히는 게 아니라 **큰 움직임이 나올 국면**을
//    고르는 장치로 일한다. 표시를 매매 확신으로 읽지 말 것.
biasRaw = close > math.max(spanA, spanB) ? 1 : close < math.min(spanA, spanB) ? -1 : 0
trendVal = request.security(syminfo.tickerid, trendTf, biasRaw[1], lookahead = barmerge.lookahead_off)

var table trendTbl = table.new(position.top_right, 1, 2, border_width = 1)
if showTrend and barstate.islast
    txt = trendVal == 1 ? "롱" : trendVal == -1 ? "숏" : "중립"
    col = trendVal == 1 ? #22c55e : trendVal == -1 ? #ef4444 : #94a3b8
    table.cell(trendTbl, 0, 0, "현재 추세 (" + trendTf + ")", text_color = #94a3b8,
      text_size = size.small, bgcolor = color.new(color.black, 20))
    table.cell(trendTbl, 0, 1, txt, text_color = col, text_size = size.large,
      bgcolor = color.new(col, 88))
