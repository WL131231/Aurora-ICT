// EMA + 구름대 터치 별표시
// 2026-08-23. nayotti_cycle 에서 덜어낸 단순판.
//
// 이 지표가 보는 것은 딱 둘이다.
//   ① 설정한 EMA 선 (최대 3개)
//   ② 일목 구름 선행스팬 A/B
// 둘 중 하나에 가격이 닿고 그 방향으로 버티면 별을 찍는다.
//
// **차트 TF 만 본다.** 상위 TF 를 안 가져오므로 request.security 가 없고,
// 그만큼 가볍다(멀티 TF 판은 nayotti_cycle.pine 쪽).
//
// 터치 판정은 백테와 같은 규칙:
//   지지 = 위에서 내려와 선에 닿고 그 위에서 마감
//   저항 = 아래서 올라가 선에 닿고 그 아래로 마감
//   같은 자리 재터치는 쿨다운 동안 다시 안 찍는다(안 그러면 봉마다 도배된다).

//@version=5
indicator("EMA + 구름 터치 별", overlay = true, max_labels_count = 500)

// ── EMA ──────────────────────────────────────────────────────────────────
grpE = "EMA"
useEma1 = input.bool(true,  "EMA 1", inline = "e1", group = grpE)
lenEma1 = input.int(200,    "",      inline = "e1", minval = 1, group = grpE)
useEma2 = input.bool(true,  "EMA 2", inline = "e2", group = grpE)
lenEma2 = input.int(480,    "",      inline = "e2", minval = 1, group = grpE)
useEma3 = input.bool(false, "EMA 3", inline = "e3", group = grpE)
lenEma3 = input.int(50,     "",      inline = "e3", minval = 1, group = grpE)
showEma = input.bool(true,  "EMA 선 그리기", group = grpE)

ema1 = ta.ema(close, lenEma1)
ema2 = ta.ema(close, lenEma2)
ema3 = ta.ema(close, lenEma3)

plot(showEma and useEma1 ? ema1 : na, "EMA 1", color = color.new(#60a5fa, 30), linewidth = 1)
plot(showEma and useEma2 ? ema2 : na, "EMA 2", color = color.new(#f472b6, 30), linewidth = 1)
plot(showEma and useEma3 ? ema3 : na, "EMA 3", color = color.new(#a3e635, 30), linewidth = 1)

// ── 일목 구름 ────────────────────────────────────────────────────────────
grpC = "구름대"
useCloud = input.bool(true, "구름 스팬 A/B 사용", group = grpC)
convLen  = input.int(9,  "전환선", minval = 1, group = grpC)
baseLen  = input.int(26, "기준선", minval = 1, group = grpC)
spanBLen = input.int(52, "선행스팬 B", minval = 1, group = grpC)
disp     = input.int(26, "선행 이동", minval = 1, group = grpC)
showCloud = input.bool(true, "구름 그리기", group = grpC)

donchian(len) => math.avg(ta.lowest(len), ta.highest(len))
leadA_raw = math.avg(donchian(convLen), donchian(baseLen))
leadB_raw = donchian(spanBLen)

// 그리기는 정석대로 앞으로 민다(현재 계산값을 disp-1 봉 뒤에 표시).
pA = plot(showCloud and useCloud ? leadA_raw : na, "선행스팬 A", offset = disp - 1, color = color.new(#22d3ee, 45))
pB = plot(showCloud and useCloud ? leadB_raw : na, "선행스팬 B", offset = disp - 1, color = color.new(#f59e0b, 45))
fill(pA, pB, color = leadA_raw >= leadB_raw ? color.new(#22d3ee, 88) : color.new(#f59e0b, 88))

// 판정에는 **지금 자리에 그려져 있는 값**을 쓴다(= disp-1 봉 전 계산값).
spanA = leadA_raw[disp - 1]
spanB = leadB_raw[disp - 1]

// ── 터치 판정 ────────────────────────────────────────────────────────────
grpD = "판정"
tolPct   = input.float(0.1, "터치 허용폭 %", minval = 0.01, step = 0.01, group = grpD)
cooldown = input.int(20, "같은 자리 재표시 대기(봉)", minval = 0, group = grpD)
markChar = input.string("★", "마커 기호", options = ["★", "✦", "●", "▲", "◆"], group = grpD)
markBig  = input.bool(false, "마커 크게", group = grpD)
supColor = input.color(#facc15, "지지 색", inline = "mc", group = grpD)
resColor = input.color(#f87171, "저항 색", inline = "mc", group = grpD)
showTag  = input.bool(true, "어느 선인지 라벨 표시", group = grpD)

tol = tolPct / 100.0

f_touch(level, isSup) =>
    band = level * tol
    isSup ? (close[1] > level and low <= level + band and close >= level - band) : (close[1] < level and high >= level - band and close <= level + band)

// 후보 선 — (가격, 이름)
var float lastPx  = na
var int   lastBar = -9999

supHit = false
resHit = false
tagTxt = ""

for pass = 0 to 1
    isSup = pass == 0
    px  = array.new_float()
    nm  = array.new_string()
    if useEma1
        array.push(px, ema1), array.push(nm, "EMA" + str.tostring(lenEma1))
    if useEma2
        array.push(px, ema2), array.push(nm, "EMA" + str.tostring(lenEma2))
    if useEma3
        array.push(px, ema3), array.push(nm, "EMA" + str.tostring(lenEma3))
    if useCloud
        if not na(spanA)
            array.push(px, spanA), array.push(nm, "스팬A")
        if not na(spanB)
            array.push(px, spanB), array.push(nm, "스팬B")

    // 닿은 것 중 현재가에 가장 가까운 선
    bestPx = float(na)
    bestNm = ""
    cnt = 0
    if array.size(px) > 0
        for i = 0 to array.size(px) - 1
            v = array.get(px, i)
            if not na(v) and f_touch(v, isSup)
                cnt += 1
                if na(bestPx) or math.abs(v - close) < math.abs(bestPx - close)
                    bestPx := v
                    bestNm := array.get(nm, i)

    if not na(bestPx)
        // 쿨다운 — 같은 가격대(±0.4%)를 최근에 이미 찍었으면 건너뛴다
        cooled = na(lastPx) or (bar_index - lastBar) > cooldown or math.abs(bestPx - lastPx) / bestPx > 0.004
        if cooled
            lastPx  := bestPx
            lastBar := bar_index
            if isSup
                supHit := true
            else
                resHit := true
            // 여러 선이 같은 자리에 겹쳤으면 개수를 함께 적는다
            tagTxt := bestNm + (cnt > 1 ? " x" + str.tostring(cnt) : "")
            break

// ── 렌더 ─────────────────────────────────────────────────────────────────
// plotchar 의 char/size 는 const 라 input 을 못 넣는다 → 기호마다 한 줄씩.
_s1 = supHit and markChar == "★"
_s2 = supHit and markChar == "✦"
_s3 = supHit and markChar == "●"
_s4 = supHit and markChar == "▲"
_s5 = supHit and markChar == "◆"
_r1 = resHit and markChar == "★"
_r2 = resHit and markChar == "✦"
_r3 = resHit and markChar == "●"
_r4 = resHit and markChar == "▲"
_r5 = resHit and markChar == "◆"

plotchar(_s1 and not markBig, title = "지지 ★", char = "★", location = location.belowbar, color = supColor, size = size.tiny)
plotchar(_s1 and markBig,     title = "지지 ★ (크게)", char = "★", location = location.belowbar, color = supColor, size = size.small)
plotchar(_s2, title = "지지 ✦", char = "✦", location = location.belowbar, color = supColor, size = size.tiny)
plotchar(_s3, title = "지지 ●", char = "●", location = location.belowbar, color = supColor, size = size.tiny)
plotchar(_s4, title = "지지 ▲", char = "▲", location = location.belowbar, color = supColor, size = size.tiny)
plotchar(_s5, title = "지지 ◆", char = "◆", location = location.belowbar, color = supColor, size = size.tiny)

plotchar(_r1 and not markBig, title = "저항 ★", char = "★", location = location.abovebar, color = resColor, size = size.tiny)
plotchar(_r1 and markBig,     title = "저항 ★ (크게)", char = "★", location = location.abovebar, color = resColor, size = size.small)
plotchar(_r2, title = "저항 ✦", char = "✦", location = location.abovebar, color = resColor, size = size.tiny)
plotchar(_r3, title = "저항 ●", char = "●", location = location.abovebar, color = resColor, size = size.tiny)
plotchar(_r4, title = "저항 ▲", char = "▲", location = location.abovebar, color = resColor, size = size.tiny)
plotchar(_r5, title = "저항 ◆", char = "◆", location = location.abovebar, color = resColor, size = size.tiny)

// 어느 선에 닿았는지 — plotchar 는 개별 텍스트를 못 넣어 label 로 따로.
// label 은 500개 제한이 있으니 필요 없으면 끈다.
if showTag and (supHit or resHit)
    label.new(bar_index, supHit ? low : high, tagTxt,
      style = supHit ? label.style_label_up : label.style_label_down,
      color = color.new(color.black, 100),
      textcolor = supHit ? supColor : resColor, size = size.tiny)

alertcondition(supHit, "지지 터치", "EMA/구름 지지 터치")
alertcondition(resHit, "저항 터치", "EMA/구름 저항 터치")
